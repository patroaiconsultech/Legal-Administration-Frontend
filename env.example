# Recommended staging topology: Legal is reverse-proxied under the same
# public Efatà host so the host-only native session cookie remains valid.
VITE_BASE_PATH=/legal/
VITE_API_BASE_URL=/legal-api
VITE_AUTH_LOGIN_URL=/access
VITE_CSRF_COOKIE_NAME=legal_csrf

# Never enable outside local development.
VITE_DEV_AUTH_ENABLED=false
VITE_DEV_TENANT_ID=
VITE_DEV_USER_ID=
